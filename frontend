  showLoading();
  const students = await DB.query('students', s => s.dept === currentUser.dept);
  const studentRegs = students.map(s => s.reg);
  const deptRequests = await DB.query('leaveRequests', r => studentRegs.includes(r.studentReg));
  
  document.getElementById('tTotalRequests').textContent = deptRequests.length;
  document.getElementById('tPendingCount').textContent = deptRequests.filter(r => r.status === 'pending').length;
  document.getElementById('tApprovedCount').textContent = deptRequests.filter(r => r.status === 'approved').length;
  document.getElementById('tRejectedCount').textContent = deptRequests.filter(r => r.status === 'rejected').length;
  showLoading(false);
}

async function displayLeaveRequests() {
  showLoading();
  const userRequests = await DB.query('leaveRequests', r => r.studentReg === currentUser.reg);
  const container = document.getElementById('leaveRequestsList');
  
  if (userRequests.length === 0) {
    container.innerHTML = `
      <div class="empty-state">
        <div class="empty-state-icon">📋</div>
        <p>No leave requests yet</p>
        <p style="font-size: 12px; margin-top: 8px;">Click "Apply for Leave" to submit your first request</p>
      </div>`;
    showLoading(false);
    return;
  }
  
  container.innerHTML = userRequests.reverse().map(req => `
    <div class="card fade-in">
      <div class="card-header">
        <div class="card-title">📅 ${formatDate(req.date)}</div>
        <span class="badge ${req.status}">
          ${req.status === 'pending' ? '⏳' : req.status === 'approved' ? '✓' : '✕'} ${req.status}
        </span>
      </div>
      <div class="card-content">${req.reason}</div>
      ${req.proofFile ? `<div class="card-meta">📎 Proof attached: ${req.proofFile.name}</div>` : ''}
      ${req.parentLetter ? `<div class="card-meta">📎 Parent's letter attached: ${req.parentLetter.name}</div>` : ''}
      <div class="card-meta">🕒 Submitted: ${new Date(req.submittedAt).toLocaleString()}</div>
      ${req.approvedBy ? `<div class="card-meta" style="color: var(--success);">✓ Approved by: ${req.approvedBy}</div>` : ''}
      ${req.rejectedBy ? `<div class="card-meta" style="color: var(--danger);">✕ Rejected by: ${req.rejectedBy}</div>` : ''}
    </div>
  `).join('');
  showLoading(false);
}

async function displayTeacherRequests() {
  showLoading();
  const students = await DB.query('students', s => s.dept === currentUser.dept);
  const studentRegs = students.map(s => s.reg);
  const deptRequests = await DB.query('leaveRequests', r => studentRegs.includes(r.studentReg));
  
  const container = document.getElementById('teacherRequestsList');
  
  if (deptRequests.length === 0) {
    container.innerHTML = `
      <div class="empty-state">
        <div class="empty-state-icon">📭</div>
        <p>No leave requests yet</p>
        <p style="font-size: 12px; margin-top: 8px;">Students haven't submitted any requests</p>
      </div>`;
    showLoading(false);
    return;
  }
  
  // Sort by date - pending first, then by submission time
  const sortedRequests = deptRequests.sort((a, b) => {
    if (a.status === 'pending' && b.status !== 'pending') return -1;
    if (a.status !== 'pending' && b.status === 'pending') return 1;
    return new Date(b.submittedAt) - new Date(a.submittedAt);
  });
  
  container.innerHTML = sortedRequests.map((req, index) => {
    const isPending = req.status === 'pending';
    const requestId = `${req.studentReg}_${req.submittedAt}`;
    
    return `
      <div class="card fade-in" id="request_${index}">
        <div class="card-title">👤 ${req.studentName} <span style="color: #64748b; font-size: 14px; font-weight: normal;">(Reg: ${req.studentReg})</span></div>
        <div class="card-header" style="margin-top: 8px;">
          <div style="color: #cbd5e1; font-size: 14px;">📅 ${formatDate(req.date)}</div>
          <span class="badge ${req.status}">
            ${req.status === 'pending' ? '⏳' : req.status === 'approved' ? '✓' : '✕'} ${req.status}
          </span>
        </div>
        <div class="card-content"><strong>Reason:</strong> ${req.reason}</div>
        ${req.proofFile ? `
          <div class="card-meta">
            📎 Proof: <a href="#" onclick="viewFile('${req.proofFile.data}', '${req.proofFile.name}'); return false;" style="color: var(--primary); text-decoration: underline;">${req.proofFile.name}</a>
          </div>
        ` : ''}
        ${req.parentLetter ? `
          <div class="card-meta">
            📎 Parent's Letter: <a href="#" onclick="viewFile('${req.parentLetter.data}', '${req.parentLetter.name}'); return false;" style="color: var(--primary); text-decoration: underline;">${req.parentLetter.name}</a>
          </div>
        ` : ''}
        <div class="card-meta">🕒 Submitted: ${new Date(req.submittedAt).toLocaleString()}</div>
        ${isPending ? `
          <div class="btn-group" style="margin-top: 16px;">
            <button class="btn success" onclick="handleApprove('${req.studentReg}', '${req.submittedAt}')">✓ Approve</button>
            <button class="btn danger" onclick="handleReject('${req.studentReg}', '${req.submittedAt}')">✕ Reject</button>
          </div>
        ` : `
          ${req.approvedBy ? `<div class="card-meta" style="color: var(--success); margin-top: 8px;">✓ Approved by: ${req.approvedBy} on ${new Date(req.approvedAt).toLocaleDateString()}</div>` : ''}
          ${req.rejectedBy ? `<div class="card-meta" style="color: var(--danger); margin-top: 8px;">✕ Rejected by: ${req.rejectedBy} on ${new Date(req.rejectedAt).toLocaleDateString()}</div>` : ''}
        `}
      </div>
    `;
  }).join('');
  showLoading(false);
}

function handleApprove(studentReg, submittedAt) {
  if (confirm('Are you sure you want to APPROVE this leave request?')) {
    approveRequest(studentReg, submittedAt);
  }
}

function handleReject(studentReg, submittedAt) {
  if (confirm('Are you sure you want to REJECT this leave request?')) {
    rejectRequest(studentReg, submittedAt);
  }
}

async function approveRequest(studentReg, submittedAt) {
  showLoading();
  try {
    const updated = await DB.update('leaveRequests', 
      r => r.studentReg === studentReg && r.submittedAt === submittedAt,
      { 
        status: 'approved', 
        approvedBy: currentUser.name, 
        approvedAt: new Date().toISOString() 
      }
    );
    
    if (updated) {
      await updateTeacherStats();
      await displayTeacherRequests();
      showNotification('Leave request approved successfully!', 'success');
    } else {
      alert('Failed to find the request. Please refresh the page.');
    }
  } catch (error) {
    console.error('Approve error:', error);
    alert('Failed to approve request. Please try again.');
  }
  showLoading(false);
}

async function rejectRequest(studentReg, submittedAt) {
  showLoading();
  try {
    const updated = await DB.update('leaveRequests',
      r => r.studentReg === studentReg && r.submittedAt === submittedAt,
      { 
        status: 'rejected', 
        rejectedBy: currentUser.name, 
        rejectedAt: new Date().toISOString() 
      }
    );
    
    if (updated) {
      await updateTeacherStats();
      await displayTeacherRequests();
      showNotification('Leave request rejected', 'warning');
    } else {
      alert('Failed to find the request. Please refresh the page.');
    }
  } catch (error) {
    console.error('Reject error:', error);
    alert('Failed to reject request. Please try again.');
  }
  showLoading(false);
}

function showLeaveForm() {
  document.getElementById('leaveFormSection').style.display = 'block';
  document.getElementById('leaveDate').value = '';
  document.getElementById('leaveReason').value = '';
  document.getElementById('proofFile').value = '';
  document.getElementById('parentLetter').value = '';
  document.getElementById('leaveMsg').innerHTML = '';
}

function hideLeaveForm() {
  document.getElementById('leaveFormSection').style.display = 'none';
}

async function submitLeaveRequest() {
  const date = document.getElementById('leaveDate').value;
  const reason = document.getElementById('leaveReason').value.trim();
  const proofFile = document.getElementById('proofFile').files[0];
  const parentLetter = document.getElementById('parentLetter').files[0];
  
  if (!date || !reason) {
    showMessage('leaveMsg', 'Please fill all required fields', 'error');
    return;
  }
  
  if (reason.length < 10) {
    showMessage('leaveMsg', 'Please provide a detailed reason (minimum 10 characters)', 'error');
    return;
  }
  
  // File size validation (5MB max)
  if (proofFile && proofFile.size > 5 * 1024 * 1024) {
    showMessage('leaveMsg', 'Proof file is too large. Maximum size is 5MB', 'error');
    return;
  }
  
  if (parentLetter && parentLetter.size > 5 * 1024 * 1024) {
    showMessage('leaveMsg', 'Parent letter file is too large. Maximum size is 5MB', 'error');
    return;
  }
  
  showLoading();
  
  try {
    const leaveData = {
      id: Date.now(),
      studentReg: currentUser.reg,
      studentName: currentUser.name,
      date: date,
      reason: reason,
      status: 'pending',
      submittedAt: new Date().toISOString()
    };
    
    // Convert files to base64 for storage
    if (proofFile) {
      const proofData = await fileToBase64(proofFile);
      leaveData.proofFile = {
        name: proofFile.name,
        type: proofFile.type,
        data: proofData
      };
    }
    
    if (parentLetter) {
      const letterData = await fileToBase64(parentLetter);
      leaveData.parentLetter = {
        name: parentLetter.name,
        type: parentLetter.type,
        data: letterData
      };
    }
    
    await DB.insert('leaveRequests', leaveData);
    
    showMessage('leaveMsg', 'Leave request submitted successfully!', 'success');
    setTimeout(async () => {
      hideLeaveForm();
      await updateLeaveStats();
      await displayLeaveRequests();
    }, 1500);
  } catch (error) {
    console.error('Submit error:', error);
    showMessage('leaveMsg', 'Failed to submit request. Please try again.', 'error');
  }
  
  showLoading(false);
}

// Helper function to convert file to base64
function fileToBase64(file) {
  return new Promise((resolve, reject) => {
    const reader = new FileReader();
    reader.onload = () => resolve(reader.result);
    reader.onerror = reject;
    reader.readAsDataURL(file);
  });
}

// Helper function to view uploaded files
function viewFile(dataUrl, fileName) {
  const newWindow = window.open();
  if (fileName.toLowerCase().endsWith('.pdf')) {
    newWindow.document.write(`
      <html>
        <head><title>${fileName}</title></head>
        <body style="margin:0">
          <embed src="${dataUrl}" width="100%" height="100%" type="application/pdf">
        </body>
      </html>
    `);
  } else {
    newWindow.document.write(`
      <html>
        <head><title>${fileName}</title></head>
        <body style="margin:0; display:flex; justify-content:center; align-items:center; background:#000;">
          <img src="${dataUrl}" style="max-width:100%; max-height:100vh;">
        </body>
      </html>
    `);
  }
}

function showChangePassword(type) {
  previousPage = type === 'student' ? 'studentPortal' : 'teacherPortal';
  showPage('changePasswordModal');
  document.getElementById('currentPass').value = '';
  document.getElementById('newPass').value = '';
  document.getElementById('confirmPass').value = '';
  document.getElementById('changePassMsg').innerHTML = '';
}

function hideChangePassword() {
  showPage(previousPage);
}

async function changePassword() {
  const currentPass = document.getElementById('currentPass').value;
  const newPass = document.getElementById('newPass').value;
  const confirmPass = document.getElementById('confirmPass').value;
  
  if (!currentPass || !newPass || !confirmPass) {
    showMessage('changePassMsg', 'Please fill all fields', 'error');
    return;
  }
  
  if (currentUser.pass !== currentPass) {
    showMessage('changePassMsg', 'Current password is incorrect', 'error');
    return;
  }
  
  if (newPass.length < 4) {
    showMessage('changePassMsg', 'New password must be at least 4 characters', 'error');
    return;
  }
  
  if (newPass !== confirmPass) {
    showMessage('changePassMsg', 'New passwords do not match', 'error');
    return;
  }
  
  showLoading();
  
  try {
    if (userType === 'student') {
      await DB.update('students', s => s.reg === currentUser.reg, { pass: newPass });
    } else {
      await DB.update('teachers', t => t.phone === currentUser.phone, { pass: newPass });
    }
    
    currentUser.pass = newPass;
    
    showMessage('changePassMsg', 'Password changed successfully!', 'success');
    setTimeout(() => {
      hideChangePassword();
    }, 2000);
  } catch (error) {
    showMessage('changePassMsg', 'Failed to change password. Please try again.', 'error');
  }
  
  showLoading(false);
}

function logout() {
  currentUser = null;
  userType = null;
  showPage('home');
}

function formatDate(dateString) {
  const date = new Date(dateString);
  const options = { year: 'numeric', month: 'long', day: 'numeric' };
  return date.toLocaleDateString('en-US', options);
}

function showNotification(message, type) {
  const notification = document.createElement('div');
  notification.className = 'message ' + type;
  const icon = type === 'success' ? '✓' : type === 'warning' ? '⚠️' : '✕';
  notification.innerHTML = `<span>${icon}</span><span>${message}</span>`;
  notification.style.position = 'fixed';
  notification.style.top = '20px';
  notification.style.left = '50%';
  notification.style.transform = 'translateX(-50%)';
  notification.style.zIndex = '9999';
  notification.style.minWidth = '300px';
  document.body.appendChild(notification);
  setTimeout(() => notification.remove(), 3000);
}

